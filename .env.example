.# Copy this file to .env.local and fill in values
DATABASE_URL=
RESEND_API_KEY=
# Sender address for verification emails. Must be on a domain verified in your
# Resend dashboard (https://resend.com/domains). If unset, falls back to
# Resend's sandbox sender, which can only deliver to the account owner's email.
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=

SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_SSL=
