# Copy this file to .env.local and fill in values

# PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/AIApps)
DATABASE_URL=

# Resend API key (https://resend.com)
RESEND_API_KEY=

# URL where your app is running (used for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
