# Copy this file to .env.local and fill in values
DATABASE_URL=
# Postgres connection pool size. Optional — defaults to 10. Lower it if your
# provider caps concurrent connections below what the default would open.
DATABASE_POOL_MAX=10
RESEND_API_KEY=
# Sender address for verification emails. Must be on a domain verified in your
# Resend dashboard (https://resend.com/domains). If unset, falls back to
# Resend's sandbox sender, which can only deliver to the account owner's email.
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the /api/webhooks/stripe endpoint (`stripe listen --print-secret`
# locally, or the "Signing secret" shown when you add the endpoint in the Stripe
# dashboard). Required for order fulfillment to work — without it the webhook
# refuses to process events.
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret for the SEPARATE /api/webhooks/stripe-connect endpoint — set
# this up in the Stripe dashboard as a "Connect" webhook (not a regular one),
# listening for payout.paid / payout.failed. This is what confirms a seller
# withdrawal actually landed in their bank, not just that the transfer to
# their Stripe balance succeeded.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_PERCENT=10
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=

SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_SSL=

# Malware scanning (ClamAV) for every seller-uploaded deliverable. Requires a
# running clamd daemon (`apt install clamav-daemon` + `freshclam`, or the
# clamav/clamav-debian-base Docker image) reachable from this app — set
# EITHER a Unix socket OR a host/port, not both. Without one of these set,
# uploads/version publishes fail closed (refused, not silently unscanned).
CLAMD_SOCKET=
CLAMD_HOST=
CLAMD_PORT=3310
