.# Copy this file to .env.local and fill in values
DATABASE_URL=
RESEND_API_KEY=
# Sender address for verification emails. Must be on a domain verified in your
# Resend dashboard (https://resend.com/domains). If unset, falls back to
# Resend's sandbox sender, which can only deliver to the account owner's email.
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=

# Signs the session cookie (HMAC-SHA256) so it can't be forged by setting an
# arbitrary userId as the cookie value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; falls back to an insecure dev-only value locally.
SESSION_SECRET=

# Encrypts third-party secrets (currently: sellers' GitHub OAuth access
# tokens) before they're stored in the database. Generate the same way as
# SESSION_SECRET. Required in production; falls back to an insecure dev-only
# value locally.
TOKEN_ENCRYPTION_KEY=

# Optional: controls TLS for the Postgres connection. Defaults to `require`
# in production (NODE_ENV=production) and off otherwise. Set to `disable` or
# `require` to override either way.
DATABASE_SSL=
