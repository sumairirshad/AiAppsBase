# Copy this file to .env.local and fill in values

# PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/AIApps)
DATABASE_URL=

# Resend API key (https://resend.com)
RESEND_API_KEY=

# URL where your app is running (used for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create OAuth App at https://github.com/settings/developers
# Callback URL must be set to: {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
