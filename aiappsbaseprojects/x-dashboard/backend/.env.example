# Copy this file to backend/.env and fill in real values. backend/.env is loaded automatically
# on startup (see Infrastructure/EnvFile.cs) and is gitignored -- never commit it.
#
# See the project README for how to create an X Developer account/app and obtain these values,
# which API access tier each feature needs, and what's free vs. paid.

# --- X API OAuth 2.0 credentials (required) ---
# From your app in the X Developer Portal (developer.x.com) -> "Keys and tokens" ->
# "OAuth 2.0 Client ID and Client Secret". The app must have "Read and write" user
# authentication settings enabled, type "Web App, Automated App or Bot".
X_CLIENT_ID=
X_CLIENT_SECRET=

# Must exactly match a callback URL registered on the app in the X Developer Portal.
# For local development: http://localhost:5080/api/auth/x/callback
X_CALLBACK_URL=http://localhost:5080/api/auth/x/callback

# Optional: override the default OAuth 2.0 scopes requested. Leave unset to use the default
# (tweet.read tweet.write users.read offline.access media.write), which is what every feature in
# this app needs. offline.access is required to receive a refresh token; without it the
# connection expires after ~2 hours and the user has to reconnect.
# X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access media.write

# --- Token encryption (required) ---
# A base64-encoded 256-bit (32 byte) key used to encrypt the connected account's OAuth tokens
# at rest in the backend's in-memory token store. Generate one with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Frontend location (optional) ---
# Where the browser is sent back to after the X OAuth callback completes. Defaults to
# http://localhost:3000 if unset.
FRONTEND_BASE_URL=http://localhost:3000
