<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; exclude it from this project's default globs. -->
    <Compile Remove="XDashboard.Api.Tests/**/*.cs" />
    <Content Remove="XDashboard.Api.Tests/**/*" />
    <None Remove="XDashboard.Api.Tests/**/*" />
  </ItemGroup>

</Project>
