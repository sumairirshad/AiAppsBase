# true = use mock/sample data, no real network calls.
# false = call the real YouTube Data API (requires the vars below).
USE_MOCK_DATA=true

# --- Real YouTube API (only required when USE_MOCK_DATA=false) ---

# API key from a Google Cloud project with the YouTube Data API v3 enabled.
# Used for read-only calls (e.g. live channel stats on the Channel Profile page).
YOUTUBE_API_KEY=

# Your channel's ID (starts with "UC", 24 characters total). Find it at
# https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=

# OAuth2 credentials from the same Google Cloud project, used for write
# calls (creating playlists, scheduling live broadcasts, updating channel
# branding, uploading videos/Shorts). Create an OAuth client (type: Desktop
# app) under APIs & Services > Credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Generate this by running: node scripts/get-youtube-token.mjs
# (one-time local OAuth consent flow; prints the refresh token to paste here)
YOUTUBE_REFRESH_TOKEN=
