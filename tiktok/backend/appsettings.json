{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=tiktok_db;Username=REPLACE_ME;Password=REPLACE_ME"
  },
  "TikTok": {
    "ClientKey": "REPLACE_WITH_TIKTOK_CLIENT_KEY",
    "ClientSecret": "REPLACE_WITH_TIKTOK_CLIENT_SECRET",
    "RedirectUri": "http://localhost:5080/api/accounts/callback",
    "AuthorizeUrl": "https://www.tiktok.com/v2/auth/authorize/",
    "TokenUrl": "https://open.tiktokapis.com/v2/oauth/token/",
    "ApiBaseUrl": "https://open.tiktokapis.com",
    "Scopes": "user.info.basic,user.info.profile,user.info.stats,video.publish,video.upload,video.list"
  },
  "AppSecurity": {
    "AdminApiKey": "REPLACE_WITH_A_LONG_RANDOM_ADMIN_KEY",
    "TokenEncryptionPurpose": "TikTok.Api.TokenProtection.v1"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3100" ]
  }
}
