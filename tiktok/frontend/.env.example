# Public values only. Never put secrets here or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_APP_NAME="TikTok Publishing Console"

# Server-only values below (read in Next.js Route Handlers / server components,
# never bundled into client JavaScript because they lack the NEXT_PUBLIC_ prefix).
API_BASE_URL=http://localhost:5080
ADMIN_API_KEY=replace-with-the-same-value-as-AppSecurity__AdminApiKey-in-the-backend
