# Aggregated reference of every environment variable used by the TikTok project.
# Each sub-project (frontend/backend) also ships its own .env.example / user-secrets
# instructions; this file exists so the whole platform's configuration surface is
# visible from one place, per the project requirements.

# --- Frontend (tiktok/frontend/.env.example) ---
NEXT_PUBLIC_APP_NAME="TikTok Publishing Console"
API_BASE_URL=http://localhost:5080
ADMIN_API_KEY=replace-with-the-same-value-as-AppSecurity__AdminApiKey-in-the-backend

# --- Backend (tiktok/backend, via appsettings.json / dotnet user-secrets / env vars) ---
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=tiktok_db;Username=REPLACE_ME;Password=REPLACE_ME"
TikTok__ClientKey=REPLACE_WITH_TIKTOK_CLIENT_KEY
TikTok__ClientSecret=REPLACE_WITH_TIKTOK_CLIENT_SECRET
TikTok__RedirectUri=http://localhost:5080/api/accounts/callback
TikTok__AuthorizeUrl=https://www.tiktok.com/v2/auth/authorize/
TikTok__TokenUrl=https://open.tiktokapis.com/v2/oauth/token/
TikTok__ApiBaseUrl=https://open.tiktokapis.com
TikTok__Scopes=user.info.basic,user.info.profile,user.info.stats,video.publish,video.upload,video.list
AppSecurity__AdminApiKey=REPLACE_WITH_A_LONG_RANDOM_ADMIN_KEY
Cors__AllowedOrigins__0=http://localhost:3100
