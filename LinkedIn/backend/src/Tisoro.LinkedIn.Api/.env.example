# Copy this file to ".env" in the same folder (src/Tisoro.LinkedIn.Api/.env) for
# local development, OR set these as real environment variables / App Service
# settings / container env vars in any other environment. Never commit a
# filled-in ".env" file — it's already covered by .gitignore.
#
# ASP.NET Core's configuration system reads nested keys from env vars using a
# double underscore as the separator, e.g. ConnectionStrings__Default maps to
# appsettings.json's ConnectionStrings:Default. Every variable below follows
# that convention.

# --- PostgreSQL ---
# Standard Npgsql connection string. Create the database first (see README).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=tisoro_linkedin;Username=postgres;Password=postgres

# --- JWT (this app's own admin login, not LinkedIn) ---
# Must be at least 32 bytes / characters. Generate one with:
#   openssl rand -base64 48
Jwt__SigningKey=

# --- Token encryption (LinkedIn access/refresh tokens at rest) ---
# Any string; it is hashed into a 32-byte AES-256 key. Generate one with:
#   openssl rand -base64 32
TokenEncryption__Key=

# --- LinkedIn OAuth app (developer.linkedin.com) ---
# Create an app under a company page you administer, request the Community
# Management API product, and add the exact redirect URI below to the app's
# "Authorized redirect URLs for your app".
LinkedIn__ClientId=
LinkedIn__ClientSecret=
LinkedIn__RedirectUri=http://localhost:5253/api/linkedin/callback

# --- Initial admin account ---
# Seeded once, on first startup, if no admin user exists yet. Change the
# password afterward; there is no open self-registration endpoint by design.
InitialAdmin__Email=admin@tisoroglobal.com
InitialAdmin__Password=change-this-before-first-run
InitialAdmin__FullName=Tisoro Admin

# --- Media storage ---
# Local directory uploaded files are written to before being pushed to
# LinkedIn at publish time. Use an absolute path outside the repo in
# production (e.g. a mounted volume) so it survives deploys.
MediaStorage__RootPath=App_Data/media

# --- CORS ---
# The frontend's origin. Add more with Cors__AllowedOrigins__1, __2, etc.
Cors__AllowedOrigins__0=http://localhost:3000

# --- Where the browser is sent after the LinkedIn OAuth callback completes ---
General__FrontendBaseUrl=http://localhost:3000

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
