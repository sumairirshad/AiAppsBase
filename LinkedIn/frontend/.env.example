# Copy this file to .env.local for local development. Never commit a filled-in
# .env.local — it's already covered by .gitignore.
#
# No real secrets belong in this app: it never holds a LinkedIn API key or
# client secret — those live only in the backend's environment. This is just
# the base URL the browser calls.

NEXT_PUBLIC_API_BASE_URL=http://localhost:5253
