{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=instagram_db;Username=CHANGE_ME;Password=CHANGE_ME"
  },
  "InstagramApi": {
    "ClientId": "REPLACE_WITH_INSTAGRAM_APP_ID",
    "ClientSecret": "REPLACE_WITH_INSTAGRAM_APP_SECRET",
    "RedirectUri": "http://localhost:3100/accounts/callback",
    "AuthorizationBaseUrl": "https://www.instagram.com/oauth/authorize",
    "TokenExchangeUrl": "https://api.instagram.com/oauth/access_token",
    "GraphApiBaseUrl": "https://graph.instagram.com",
    "GraphApiVersion": "v21.0",
    "Scopes": [
      "instagram_business_basic",
      "instagram_business_content_publish",
      "instagram_business_manage_comments",
      "instagram_business_manage_insights"
    ]
  },
  "AdminAuth": {
    "ApiKey": "REPLACE_WITH_STRONG_RANDOM_ADMIN_API_KEY"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3100"]
  },
  "PublishingWorker": {
    "PollIntervalSeconds": 60,
    "ContainerStatusPollIntervalSeconds": 5,
    "ContainerStatusMaxAttempts": 20,
    "MaxAttemptsPerJob": 3
  },
  "DataProtection": {
    "KeyRingPath": "./keys"
  }
}
