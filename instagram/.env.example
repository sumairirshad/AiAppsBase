# This file documents every environment variable used across the Instagram
# project. The actual values live in instagram/backend (appsettings.json +
# dotnet user-secrets, or real environment variables in production) and
# instagram/frontend/.env.local. Nothing here is a real credential.

# ---- Backend: instagram/backend (appsettings.json / env vars / user-secrets) ----
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=instagram_db;Username=CHANGE_ME;Password=CHANGE_ME
InstagramApi__ClientId=REPLACE_WITH_INSTAGRAM_APP_ID
InstagramApi__ClientSecret=REPLACE_WITH_INSTAGRAM_APP_SECRET
InstagramApi__RedirectUri=http://localhost:3100/accounts/callback
InstagramApi__AuthorizationBaseUrl=https://www.instagram.com/oauth/authorize
InstagramApi__TokenExchangeUrl=https://api.instagram.com/oauth/access_token
InstagramApi__GraphApiBaseUrl=https://graph.instagram.com
InstagramApi__GraphApiVersion=v21.0
AdminAuth__ApiKey=REPLACE_WITH_STRONG_RANDOM_ADMIN_API_KEY
Cors__AllowedOrigins__0=http://localhost:3100
DataProtection__KeyRingPath=./keys

# ---- Frontend: instagram/frontend/.env.local (server-only, never NEXT_PUBLIC_) ----
INSTAGRAM_BACKEND_URL=http://localhost:5280
INSTAGRAM_ADMIN_API_KEY=REPLACE_WITH_SAME_VALUE_AS_BACKEND_AdminAuth__ApiKey
